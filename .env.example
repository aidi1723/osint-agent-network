APP_ENV=development
# 127.0.0.1 可在未设置令牌时启动。改成 0.0.0.0 前必须设置 AGENT_API_TOKEN 或 ADMIN_API_TOKEN。
APP_HOST=127.0.0.1
APP_PORT=8088
AGENT_API_TOKEN=
ADMIN_API_TOKEN=
OSINT_DB_PATH=./data/osint.sqlite
DATABASE_URL=sqlite:///./data/osint.db
JOB_WORKDIR=./data/jobs
ARTIFACT_DIR=./data/artifacts

WEB_PORT=3008
API_BASE_URL=http://localhost:8088

OSINT_LLM_BASE_URL=
OSINT_LLM_API_KEY=
OSINT_LLM_MODEL=gpt-5.4
OSINT_LLM_TIMEOUT=30

SHERLOCK_COMMAND=python3
SHERLOCK_MODULE=sherlock_project
SHERLOCK_PATH=
THEHARVESTER_PATH=/opt/osint/theHarvester/theHarvester.py
THEHARVESTER_COMMAND=python3
THEHARVESTER_SOURCES=all
THEHARVESTER_LIMIT=500
AMASS_COMMAND=amass
AMASS_PASSIVE=true

SPIDERFOOT_BASE_URL=
SPIDERFOOT_API_KEY=
SPIDERFOOT_SCAN_TYPE=passive
PHONEINFOGA_BASE_URL=
PHONEINFOGA_API_KEY=
GHUNT_COMMAND=ghunt
GHUNT_COOKIE_PATH=
RECONNG_COMMAND=recon-ng
COMPANY_NEWS_COMMAND=python3
COMPANY_NEWS_SOURCE=gnews
COMPANY_NEWS_LIMIT=10
COMPANY_NEWS_DAYS=365
